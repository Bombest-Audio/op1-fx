{
  "name": "Punch",
  "vendor": "bombest",
  "uid": "BbPn",
  "version": 1001,
  "so": "punch.so",
  "params": "params.json",
  "layout": "layout.conf",
  "art": "html",
  "effect": true,
  "targets": [
    "armv7",
    "aarch64"
  ],
  "build": {
    "root": "..",
    "sources": [
      "core/punch_core.c",
      "mpc/engine.c"
    ],
    "cflags": [
      "-Icore",
      "-O2"
    ],
    "libs": [
      "-lm",
      "-lpthread"
    ]
  },
  "defines": {
    "HAS_DISPLAY_REV": 1,
    "DISPLAY_REV_NO_UPDATE": 1
  },
  "presets": "presets.json"
}
