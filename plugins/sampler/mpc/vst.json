{
  "name": "Sampler",
  "vendor": "bombest",
  "uid": "BbSm",
  "version": 1000,
  "so": "sampler.so",
  "params": "params.json",
  "layout": "layout.conf",
  "art": "html",
  "targets": ["armv7", "aarch64"],
  "defines": {"SAMPLE_ACCURATE": 1, "MODULE_SUBDIR": "\"samples\""},
  "build": {
    "root": "..",
    "sources": ["core/sampler_core.c", "mpc/sampler_wav.c", "mpc/engine.c"],
    "cflags": ["-Icore", "-Impc", "-O2"],
    "libs": ["-lm", "-lpthread"]
  }
}
